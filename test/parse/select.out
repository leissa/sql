SELECT * FROM t;
SELECT a FROM t;
SELECT DISTINCT a FROM t;
SELECT t.* FROM t;
SELECT a, b AS alias, c AS (x, y) FROM t;
SELECT a FROM t, u, v;
SELECT a FROM long_table_name AS t;
SELECT a FROM long_table_name AS t;
SELECT a FROM t WHERE (a = 1);
SELECT a FROM t GROUP BY a, b;
SELECT a FROM t GROUP BY a HAVING (count(*) > 1);
SELECT a FROM t WHERE (a = 1) GROUP BY b HAVING (sum(c) > 2);
SELECT count(*), count(DISTINCT a), count(a), min(a), max(b), sum(c), avg(d) FROM t;
SELECT lower(a), some_udf(a, b, 1) FROM t;
SELECT a FROM t ORDER BY a ASC;
SELECT a FROM t ORDER BY a ASC, b DESC, 3 ASC;
SELECT a FROM t ORDER BY a ASC OFFSET 10 ROWS;
SELECT a FROM t ORDER BY a ASC OFFSET 10 ROWS FETCH NEXT 5 ROWS ONLY;
SELECT a FROM t FETCH NEXT 1 ROWS ONLY;
