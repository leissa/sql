CREATE TABLE students (name text, student_number INTEGER, city text, grade DOUBLE PRECISION, credits BIGINT);
CREATE TABLE students (name text, student_number INTEGER NOT NULL, city text, grade DOUBLE PRECISION PRIMARY KEY UNIQUE);
CREATE TABLE teachers (name VARCHAR(30), student_number long, city CHAR(10), grade FLOAT);
CREATE TABLE teachers (name VARCHAR(30), student_number long, city CHAR(10), grade FLOAT, PRIMARY KEY (name, student_number));
CREATE TABLE teachers (name CHARACTER VARYING(30));
